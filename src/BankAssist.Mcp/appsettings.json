{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Vault": {
    "TtlMinutes": 30,
    "MaxEntriesPerSession": 5000
  },
  "Masking": {
    "ScanFreeTextFields": ["note", "description"]
  },
  "Data": {
    "Directory": "data"
  },
  "Audit": {
    "Directory": "logs"
  }
}
